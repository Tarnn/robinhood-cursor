# Second-opinion reviewer (rht opinion request). Copy to .env — NEVER commit .env.
# Missing key = trades blocked (fail closed), so set this before going live.

# anthropic (default) | glm
REVIEWER_PROVIDER=anthropic

# Anthropic Messages API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Reviewer model. Default keeps to a strong, current model; override deliberately.
REVIEWER_MODEL=claude-sonnet-5

# Only needed when REVIEWER_PROVIDER=glm (z.ai Anthropic-compatible endpoint)
GLM_AUTH_TOKEN=
